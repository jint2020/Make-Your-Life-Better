            "title": "Created At",
            "type": "string"
          },
          "files": {
            "items": {
              "$ref": "#/components/schemas/CloudFileOut"
            },
            "title": "Files",
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "tool_id": {
            "title": "Tool Id",
            "type": "string"
          },
          "total_bytes": {
            "title": "Total Bytes",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "tool_id",
          "name",
          "total_bytes",
          "created_at",
          "files",
          "config"
        ],
        "title": "CloudTaskDetail",
        "type": "object"
      },
      "CloudTaskSummary": {
        "properties": {
          "created_at": {
            "format": "date-time",
