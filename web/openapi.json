          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "tool_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Tool Id",
            "type": "string"
          }
        },
        "required": [
          "tool_id",
          "name",
          "config",
          "files"
        ],
        "title": "Body_createCloudTask",
        "type": "object"
      },
      "CloudFileOut": {
        "properties": {
          "content_type": {
            "title": "Content Type",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "size": {
            "title": "Size",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "size",
          "content_type"
        ],
        "title": "CloudFileOut",
        "type": "object"
      },
      "CloudTaskDetail": {
        "properties": {
          "config": {
            "additionalProperties": true,
            "title": "Config",
            "type": "object"
          },
