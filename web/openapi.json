            "title": "Files",
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "tool_id": {
            "title": "Tool Id",
            "type": "string"
          },
          "total_bytes": {
            "title": "Total Bytes",
