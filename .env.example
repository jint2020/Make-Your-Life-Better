# 生产部署：复制为 .env 后填写。不要提交 .env

# 镜像版本：latest、main 分支的 sha-xxxxxxx，或者 v1.2.3 这样的 tag。回滚时改这里
APP_VERSION=latest

# 域名。Caddy 会自动申请 HTTPS 证书（域名要先解析到这台服务器，80/443 端口要放开）
SITE_ADDRESS=tools.example.com

# 发送登录验证码的 SMTP（QQ / 163 邮箱要先开启 SMTP 并使用授权码）
# SMTP_SECURITY：ssl（一般是 465 端口）、starttls（一般是 587 端口）、none
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=no-reply@example.com
SMTP_PASSWORD=请填授权码或密码
SMTP_FROM=Make Your Life Better <no-reply@example.com>

# 云端额度（可选，单位字节 / 个）
# USER_QUOTA_BYTES=524288000
# USER_MAX_TASKS=50
# MAX_FILE_BYTES=52428800

# 文件转 Markdown（可选，单位字节 / 次数 / 秒）
# CONVERT_MAX_FILE_BYTES=20971520
# CONVERT_HOURLY_LIMIT=60
# CONVERT_DAILY_LIMIT=300
# CONVERT_REQUEST_TIMEOUT_SECONDS=100
# 所有用户合计同时转换的文件数
# CONVERT_MAX_IN_FLIGHT=10
# 网关（Caddy）对 /api/convert 的请求体上限，要比 CONVERT_MAX_FILE_BYTES 多留出 multipart 开销，两个一起改
# CONVERT_BODY_LIMIT=21MiB

POSTGRES_PASSWORD=请换成随机长密码
MINIO_ROOT_PASSWORD=请换成随机长密码（至少 8 位）
